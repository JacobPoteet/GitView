{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitView",
  "version": "0.5.0",
  "identifier": "com.jacobpoteet.gitview",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitView",
        "width": 1480,
        "height": 940,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0B0C0F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
